{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LongCut Template",
  "description": "龙儿剪辑模板：清单(manifest) + 蓝图(blueprint)。蓝图字段直接对应 Concat 的 Timeline/Clip，片段用 slot 引用槽位，支持占位表达式 {{slot.<id>.duration}} / {{prev.end}} / {{title}}。数值下界与必填字段在此约束；槽位 min/max 关系、aspect 与画幅一致性等跨字段规则由实例化器做业务校验，见 docs/TEMPLATE-SYSTEM.zh.md 第 4.1 节。",
  "type": "object",
  "required": ["manifest", "blueprint"],
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "type": "object",
      "required": ["id", "name", "version", "slots"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "author": {"type": "string"},
        "description": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "aspect": {"enum": ["16:9", "9:16", "1:1", "4:3"]},
        "defaultDuration": {"type": "number", "exclusiveMinimum": 0},
        "minClipping": {"type": "number", "minimum": 0},
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "role", "accepts"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "role": {"enum": ["main_video","secondary_video","photo","music","sfx","title_text","subtitle","logo","overlay"]},
              "accepts": {"type": "array", "minItems": 1, "items": {"enum": ["video","image","audio","text"]}},
              "min": {"type": "integer", "minimum": 0},
              "max": {"type": "integer", "minimum": 0},
              "preferredDuration": {"type": "number", "exclusiveMinimum": 0},
              "beatSync": {"type": "boolean"},
              "kenBurns": {"type": "boolean"},
              "placeholder": {"type": "string"}
            }
          }
        }
      }
    },
    "blueprint": {
      "type": "object",
      "required": ["video", "tracks", "clips"],
      "additionalProperties": false,
      "properties": {
        "video": {
          "type": "object",
          "required": ["width","height","rateNum","rateDen"],
          "additionalProperties": false,
          "properties": {
            "width": {"type":"integer", "minimum": 1},
            "height": {"type":"integer", "minimum": 1},
            "rateNum": {"type":"integer", "minimum": 1},
            "rateDen": {"type":"integer", "minimum": 1},
            "colorSpace": {"enum":["sdr","hlg","pq"]}
          }
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id","kind"],
            "additionalProperties": false,
            "properties": {
              "id": {"type":"string", "minLength": 1},
              "kind": {"enum":["video","audio"]},
              "visible": {"type":"boolean"},
              "muted": {"type":"boolean"}
            }
          }
        },
        "clips": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["slot","track"],
            "additionalProperties": false,
            "properties": {
              "slot": {"type":"string", "minLength": 1},
              "track": {"type":"string", "minLength": 1},
              "start": {"type":["number","string"], "minimum": 0},
              "duration": {"type":["number","string"], "minimum": 0},
              "scale": {"type":"number", "exclusiveMinimum": 0},
              "opacity": {"type":"number", "minimum": 0, "maximum": 1},
              "volume": {"type":"number", "minimum": 0},
              "kenBurns": {"type":"boolean"},
              "filters": {
                "type":"array",
                "items": {
                  "type":"object",
                  "required": ["id"],
                  "additionalProperties": false,
                  "properties": {
                    "id": {"type":"string", "minLength": 1},
                    "params": {"type":"object"}
                  }
                }
              },
              "transition_in": {
                "type":"object",
                "required": ["id","duration"],
                "additionalProperties": false,
                "properties": {
                  "id": {"type":"string", "minLength": 1},
                  "duration": {"type":"number", "exclusiveMinimum": 0}
                }
              },
              "text": {"type":"string"},
              "textStyle": {"type":"object"}
            }
          }
        }
      }
    }
  }
}
